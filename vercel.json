{
  "cleanUrls": true,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "redirects": [
    {
      "source": "/work/(?<id>jiffcy|rlwrld|yoki|pikabon|uline|link|workspot|shuttlepay|pairs|taxnap|wealthpark|wplab|pokke|kyash|croc|metajob|one|onepay|aeon|cookpadvideo|cookpad|logoideas)/",
      "destination": "/work/:id",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/work/jiffcy", "destination": "/" },
    { "source": "/work/rlwrld", "destination": "/" },
    { "source": "/work/yoki", "destination": "/" },
    { "source": "/work/pikabon", "destination": "/" },
    { "source": "/work/uline", "destination": "/" },
    { "source": "/work/link", "destination": "/" },
    { "source": "/work/workspot", "destination": "/" },
    { "source": "/work/shuttlepay", "destination": "/" },
    { "source": "/work/pairs", "destination": "/" },
    { "source": "/work/taxnap", "destination": "/" },
    { "source": "/work/wealthpark", "destination": "/" },
    { "source": "/work/wplab", "destination": "/" },
    { "source": "/work/pokke", "destination": "/" },
    { "source": "/work/kyash", "destination": "/" },
    { "source": "/work/croc", "destination": "/" },
    { "source": "/work/metajob", "destination": "/" },
    { "source": "/work/one", "destination": "/" },
    { "source": "/work/onepay", "destination": "/" },
    { "source": "/work/aeon", "destination": "/" },
    { "source": "/work/cookpadvideo", "destination": "/" },
    { "source": "/work/cookpad", "destination": "/" },
    { "source": "/work/logoideas", "destination": "/" }
  ]
}
