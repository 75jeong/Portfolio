---
import Base from '../layouts/Base.astro';
import Strike from '../components/Strike.astro';
---
<Base title="Page not found">
  <section class="nf wrap">
    <p class="mono muted">404</p>
    <h1 class="nf__t display"><Strike text="This page" mode="intro" label={false} /><br />was cut.</h1>
    <p style="max-width:36ch;font-size:var(--t-m)">The link may be old. Everything that stayed is on the front page.</p>
    <p><a class="btn" href="/" data-magnetic="0.3">Back to the work <span class="btn__arr" aria-hidden="true">→</span></a></p>
  </section>
</Base>
