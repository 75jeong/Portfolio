---
import Base from '../../layouts/Base.astro';
import Strike from '../../components/Strike.astro';
import { cases } from '../../data/site';

export function getStaticPaths() {
  return cases.map((c, i) => ({ params: { slug: c.slug }, props: { c, next: cases[(i + 1) % cases.length] } }));
}
const { c, next } = Astro.props;
const phones = c.gallery.filter((g) => g.kind === 'phone');
const rest = c.gallery.filter((g) => g.kind !== 'phone');
---
<Base title={`${c.title}${c.sub ? ' ' + c.sub : ''}`} description={c.line}>
  <article>
    <header class="ch wrap">
      <div class="ch__top mono"><span>Case {c.no} / 06</span><span class="muted">{c.years}</span></div>
      <h1 class="ch__title display" data-split="lines" data-intro>{c.title}{c.sub && <span class="ch__sub">{c.sub}</span>}</h1>
      <p class="ch__line" data-reveal="up" data-intro data-delay="0.35">{c.line}</p>
      <dl class="ch__meta" data-reveal="fade" data-intro data-delay="0.5">
        {c.meta.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="ch__links mono">
        {c.links.map((l) => <a class="ul" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
      </div>
    </header>

    <figure class={`cover ${c.cover.kind === 'phone' ? 'cover--phone' : ''}`} data-reveal="scale" data-intro data-delay="0.2" style="margin:0">
      <img src={c.cover.src} alt={c.cover.alt} width={c.cover.w} height={c.cover.h} data-critical {...(c.cover.kind !== 'phone' ? { 'data-parallax': '0.08' } : {})} />
    </figure>

    <div class="wrap">
      <section class="blk" aria-labelledby="p-h">
        <div class="blk__h"><span class="mono muted">01</span><h2 id="p-h">Problem</h2></div>
        <div class="blk__b">{c.problem.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
      </section>
      <section class="blk" aria-labelledby="r-h">
        <div class="blk__h"><span class="mono muted">02</span><h2 id="r-h">Research</h2></div>
        <div class="blk__b"><ul>{c.research.map((p) => <li>{p}</li>)}</ul></div>
      </section>
      <section class="blk" aria-labelledby="c-h">
        <div class="blk__h"><span class="mono muted">03</span><h2 id="c-h">Constraints</h2></div>
        <div class="blk__b"><ul>{c.constraints.map((p) => <li>{p}</li>)}</ul></div>
      </section>
      <section class="blk" aria-labelledby="d-h">
        <div class="blk__h"><span class="mono muted">04</span><h2 id="d-h">Decisions</h2></div>
        <p class="blk__b muted mono" style="align-self:end">Cut / Decision</p>
        <ol class="dec">
          {c.decisions.map((d) => (
            <li>
              <p class="dec__cut"><Strike text={d.cut} mode="scroll" /></p>
              <h3 class="dec__t" data-split="lines">{d.title}</h3>
              <p class="dec__w">{d.why}</p>
            </li>
          ))}
        </ol>
      </section>

      {phones.length > 0 && (
        <div class="gal">
          {phones.map((g, i) => (
            <figure class="g-phone" data-reveal="up" data-delay={String(i * 0.06)}>
              <img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
      {rest.length > 0 && (
        <div class={`gal ${rest.length % 2 === 0 && rest.every((g) => g.kind === 'wide' && g.w < 1000) ? 'gal--pair' : ''}`}>
          {rest.map((g) => (
            <figure class={g.kind === 'wide' ? 'g-wide' : 'g-std'} data-reveal="clip">
              <img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
      {c.galleryNote && <p class="mono muted" style="margin-top:-2rem;padding-bottom:2rem">{c.galleryNote}</p>}

      <section class="blk" aria-labelledby="o-h">
        <div class="blk__h"><span class="mono muted">05</span><h2 id="o-h">{c.outcomeLabel ?? 'Outcome'}</h2></div>
        <div class="blk__b">{c.outcome.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
      </section>

      <a class="next" href={`/work/${next.slug}/`} data-cursor="Next">
        <span class="mono muted">Next case {next.no}</span><br />
        <span class="next__t display">{next.title} <span class="next__arr" aria-hidden="true">→</span></span>
      </a>
    </div>
  </article>
</Base>
