---
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Loading">
  <div class="ld">
    <div class="ld__top mono"><span>{site.name}</span><span>Proof, 2000 to 2026</span></div>
    <div class="ld__year"><span data-loader-count>2000</span><i class="ld__strike" aria-hidden="true"></i></div>
    <div class="ld__bar" data-loader-bar></div>
  </div>
</div>
