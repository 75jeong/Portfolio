---
import Mark from './Mark.astro';
const home = Astro.url.pathname === '/';
const p = home ? '' : '/';
---
<header class="hd">
  <a class="hd__home" href="/" aria-label="aftworks, home"><Mark label="aftworks" /></a>
  <nav class="hd__nav mono" aria-label="Main">
    <span class="hd__clock" data-clock aria-label="Local time in Tokyo">Tokyo</span>
    <a class="ul" href={`${p}#work`}>Work</a>
    <a class="ul" href={`${p}#about`}>About</a>
    <a class="ul" href={`${p}#contact`}>Contact</a>
  </nav>
</header>
