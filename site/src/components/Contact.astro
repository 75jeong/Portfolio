---
import { site } from '../data/site';
import Mark from './Mark.astro';
---
<section class="ct wrap" id="contact" aria-labelledby="ct-h">
  <p class="mono muted" id="ct-h">Contact</p>
  <p class="ct__lede" style="max-width:32ch;margin-top:1rem;font-size:var(--t-m);line-height:1.3">Have a product decision to make? Write to me, or book thirty minutes.</p>
  <a class="ct__mail" href={`mailto:${site.email}`} data-copy={site.email} data-cursor="Email"><span class="ul">{site.email}</span></a>
  <div class="ct__row">
    <a class="btn btn--paper" href={site.booking} target="_blank" rel="noopener" data-magnetic="0.3">Book a 30 min 1:1 <span class="btn__arr" aria-hidden="true">↗</span></a>
    <div class="ct__links mono">
      {site.socials.map((s) => <a class="ul" href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)}
      <button class="ul mono" type="button" data-copy-btn={site.email}>Copy email</button>
    </div>
  </div>
  <footer class="ft mono muted">
    <span>© 2026 Jeong Jinho · aftworks</span>
    <span>Tokyo, Japan. Korean (native), Japanese (business)</span>
    <a class="ul" href="#main" data-top>Back to top ↑</a>
    <Mark label="aftworks" />
  </footer>
</section>
